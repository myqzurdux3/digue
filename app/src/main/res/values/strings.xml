    <!--
      Counted quantities, which English inflects and French does not: "1 snapshot"
      against "1 instantané", but "Retenu 1 fois" like "Retenu 3 fois". The four
      live here rather than as plain strings so the English build never reads
      "Held back 1 times". The quantity is the count of things, not necessarily
      the first argument: capture_running is picked by its snapshots while its
      seconds sit in %1$d.
    -->
    <plurals name="capture_running">
        <item quantity="one">Capturing — %1$d s left, %2$d snapshot</item>
        <item quantity="other">Capturing — %1$d s left, %2$d snapshots</item>
    </plurals>
    <plurals name="capture_done">
        <item quantity="one">Done: %1$d snapshot saved.</item>
        <item quantity="other">Done: %1$d snapshots saved.</item>
    </plurals>
    <plurals name="captures_on_disk">
        <item quantity="one">%1$d snapshot on disk — %2$s</item>
        <item quantity="other">%1$d snapshots on disk — %2$s</item>
    </plurals>
    <plurals name="today_total">
        <item quantity="one">Held back %1$d time</item>
        <item quantity="other">Held back %1$d times</item>
    </plurals>
</resources>
