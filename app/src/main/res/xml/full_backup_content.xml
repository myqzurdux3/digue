<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 11-and-earlier half of the same refusal as data_extraction_rules.
  `allowBackup="false"` already switches backup off everywhere, so nothing here
  is load-bearing today; it exists so that the day someone turns backup on for
  an unrelated reason, the block history is not what gets uploaded.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
