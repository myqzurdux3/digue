<?xml version="1.0" encoding="utf-8"?>
<!--
  Same geometry as ic_digue, placed in the 108x108 adaptive-icon foreground.

  The group maps each 48-box point p to p * 1.15 + (28.125, 26.4), which puts the
  mark's bounding box — 39 x 38 including stroke width — centred on (54, 54). Its
  half-diagonal is then 31.3, inside the 66dp-diameter safe circle (radius 33) that
  survives every launcher mask, circular included.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.15"
        android:scaleY="1.15"
        android:translateX="28.125"
        android:translateY="26.4">

        <path
            android:pathData="M5,16 C9,9.5 14.5,9.5 18.5,16 C22.5,22.5 27,22.5 31,16"
            android:strokeColor="@color/accent"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M8.5,25 C12,19 17,19 20.75,25 C24.5,31 27.5,31 31,25"
            android:strokeColor="@color/accent"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M12,34 C15,29 19,29 22.5,34 C25.5,38.5 28.5,38.5 31,34"
            android:strokeColor="@color/accent"
            android:strokeWidth="4"
            android:strokeLineCap="round" />

        <path
            android:pathData="M35,5 L42,5 L42,43 L35,43 Z"
            android:fillColor="@color/encre" />
    </group>
</vector>
