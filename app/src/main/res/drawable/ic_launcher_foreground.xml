<?xml version="1.0" encoding="utf-8"?>
<!--
  Same geometry as ic_digue, placed in the 108x108 adaptive-icon foreground.

  The group maps each 48-box point p to p * 1.2 + (25.8, 25.2). The mark's
  bounding box is 39 x 36, so scaled it spans 46.8 x 43.2 centred on (54, 54),
  giving a half-diagonal of 31.8 — inside the 66dp-diameter safe circle
  (radius 33) that survives every launcher mask, circular included.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.2"
        android:scaleY="1.2"
        android:translateX="25.8"
        android:translateY="25.2">

        <path
            android:pathData="M4,42 L4,33 C14,33 19,29 24,22 C28,16 30,11 33,11 L33,42 Z"
            android:fillColor="@color/accent" />

        <path
            android:pathData="M33,6 L43,6 L43,42 L33,42 Z"
            android:fillColor="@color/encre" />
    </group>
</vector>
