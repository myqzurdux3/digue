<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: water piled against a dike.

  Two filled shapes, not strokes. The first version was three thin waves plus a
  bar and read as a punctuation glyph; the second peaked in the middle and read
  as a hill. Here the water rises as it approaches the wall and is highest where
  it meets it, which is what being held back looks like. The wall stands taller
  than the water it holds.

  Authored in a 48x48 box; ic_launcher_foreground scales this same geometry.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <path
        android:pathData="M4,42 L4,33 C14,33 19,29 24,22 C28,16 30,11 33,11 L33,42 Z"
        android:fillColor="@color/accent" />

    <path
        android:pathData="M33,6 L43,6 L43,42 L33,42 Z"
        android:fillColor="@color/encre" />
</vector>
