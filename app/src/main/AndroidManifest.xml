<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Android 11+ (targetSdk 35 here) hides other apps' package info by default.
      Without this, PackageManager#getPackageInfo on any of these package names
      throws NameNotFoundException even when the app is installed, and the home
      screen's "installed apps" detection silently reports nothing. This does not
      grant any new capability beyond seeing whether these five specific packages
      are present.
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.kids" />
        <package android:name="app.revanced.android.youtube" />
        <package android:name="com.snapchat.android" />
    </queries>

    <!--
      tools:ignore on localeConfig: the attribute lands in the per-app language
      picker on Android 13+ and is ignored below, where the app just follows the
      system locale. That is the intended behaviour, not an oversight.
    -->
    <application
        tools:ignore="UnusedAttribute"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReelsOff">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.InstagramWatcherService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
